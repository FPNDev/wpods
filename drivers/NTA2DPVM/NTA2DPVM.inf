[Version]
Signature="$WINDOWS NT$"
Class=MEDIA
ClassGuid={4D36E96C-E325-11CE-BFC1-08002BE10318}
Provider=%ProviderName%
DriverVer=01/01/2026,1.0.0.0
CatalogFile=NTA2DPVM.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=13

[SourceDisksNames]
1=%DiskName%

[SourceDisksFiles]
NTA2DPVM.sys=1

[Manufacturer]
%ProviderName%=Models,NTamd64.10.0...22000

[Models.NTamd64.10.0...22000]
%DeviceDescription%=NTA2DPVM_Install,Root\NTA2DPVM

[NTA2DPVM_Install.NT]
CopyFiles=NTA2DPVM_Files
AddReg=NTA2DPVM_AddReg

[NTA2DPVM_Files]
NTA2DPVM.sys

[NTA2DPVM_AddReg]
HKR,MediaCategories\%MicrophonePinGuid%,Name,,%MicrophoneName%

[NTA2DPVM_Install.NT.Services]
AddService=NTA2DPVM,0x00000002,NTA2DPVM_Service

[NTA2DPVM_Service]
DisplayName=%DeviceDescription%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\NTA2DPVM.sys

[NTA2DPVM_Install.NT.Wdf]
KmdfService=NTA2DPVM,NTA2DPVM_Wdf

[NTA2DPVM_Wdf]
KmdfLibraryVersion=$KMDFVERSION$

[NTA2DPVM_Install.NT.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_Microphone%,NTA2DPVM_Microphone
AddInterface=%KSCATEGORY_CAPTURE%,%KSNAME_Microphone%,NTA2DPVM_Microphone
AddInterface=%KSCATEGORY_REALTIME%,%KSNAME_Microphone%,NTA2DPVM_Microphone

[NTA2DPVM_Microphone]
AddReg=NTA2DPVM_Microphone_AddReg

[NTA2DPVM_Microphone_AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%MicrophoneName%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

[Strings]
ProviderName="NTA2DPVM"
DiskName="NTA2DPVM installation media"
DeviceDescription="Airpods A2DP"
MicrophoneName="Headset (A2DP)"
MicrophonePinGuid="{17A330B3-1A96-463F-841F-679F7A9A3DB8}"
KSNAME_Microphone="Nta2dpvm0"
Proxy.CLSID="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_CAPTURE="{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME="{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSNODETYPE_ANY="{00000000-0000-0000-0000-000000000000}"
PKEY_AudioEndpoint_Association="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
PKEY_AudioEndpoint_Supports_EventDriven_Mode="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"
