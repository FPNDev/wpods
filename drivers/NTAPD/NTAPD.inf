[Version]
Signature="$WINDOWS NT$"
Class=Bluetooth
ClassGuid={e0cbf06c-cd8b-4647-bb8a-263b43f0f974}
Provider=%ProviderName%
DriverVer=01/01/2026,1.0.0.0
CatalogFile=NTAPD.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=13

[SourceDisksNames]
1=%DiskName%

[SourceDisksFiles]
NTAPD.sys=1

[Manufacturer]
%ProviderName%=Models,NTamd64.10.0...16299

[Models.NTamd64.10.0...16299]
%DeviceDesc%=NTAPD_Install,BTHENUM\{74ec2172-0bad-4d01-8f77-997b2be0722a}

[NTAPD_Install.NT]
CopyFiles=NTAPD_Files

[NTAPD_Files]
NTAPD.sys

; Applied by PnP to every device object of the stack, including the PDO that the interface path names.
[NTAPD_Install.NT.HW]
AddReg=NTAPD_HW_AddReg

[NTAPD_HW_AddReg]
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGW;;;BU)"
HKR,,DeviceCharacteristics,0x10001,0x100 ; FILE_DEVICE_SECURE_OPEN

[NTAPD_Install.NT.Services]
AddService=NTAPD,0x00000002,NTAPD_Service

[NTAPD_Service]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\NTAPD.sys

[NTAPD_Install.NT.Wdf]
KmdfService=NTAPD,NTAPD_Wdf

[NTAPD_Wdf]
KmdfLibraryVersion=$KMDFVERSION$

[Strings]
ProviderName="NTAPD"
DeviceDesc="NTAPD AirPods Bluetooth profile"
ServiceName="NT AirPods Driver"
DiskName="NTAPD installation media"
