<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>WPods</AssemblyName>
    <RootNamespace>WPods</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\WPods.ico</ApplicationIcon>
    <SelfContained>false</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- DPI awareness is declared in app.manifest (process-wide, before any code) and also set via SetHighDpiMode. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <!-- Size: no package XML docs; WebView2Loader.dll only once (NuGet win-x64 asset in the app root). -->
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <WebView2NeverCopyLoaderDllToOutputDirectory>true</WebView2NeverCopyLoaderDllToOutputDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\.build\native\bin\*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\native\licenses\**" LinkBase="licenses\" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="web\**" CopyToOutputDirectory="PreserveNewest" />
    <None Remove="web\**" />
    <Content Include="locales\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The WebView2 package also references its WPF control; WPods only uses WinForms. -->
  <Target Name="RemoveWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
